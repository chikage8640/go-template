{
  "name": "Go",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.27",
      "installGoTools": true
    },
    "ghcr.io/devcontainers/features/node:2.1.1": {},
    "ghcr.io/thamaji/devcontainer-features/codex-cli:latest": {},
    "ghcr.io/thamaji/devcontainer-features/gitleaks:latest": {},
    "ghcr.io/thamaji/devcontainer-features/lefthook:latest": {}
  },
  "remoteEnv": {
    "GOPATH": "/home/vscode/go",
    "PATH": "/home/vscode/.local/bin:/home/vscode/go/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "streetsidesoftware.code-spell-checker",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "[go.mod]": {
          "editor.formatOnSave": true
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
